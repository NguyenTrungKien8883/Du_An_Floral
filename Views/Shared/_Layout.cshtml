<!DOCTYPE html>
<html>
<head>
    <title>@ViewData["Title"] - Floral Design</title>
    <link rel="stylesheet" href="~/css/styles.css" />
</head>

<body>

<div id="container">

    <div id="topLine"></div>

    <div id="logoPan">
        <img src="~/images/logo.gif" id="logo" />
        <img src="~/images/slogan.gif" id="slogan" />
    </div>

    <div id="menuPan">
        <ul class="menu">
            <li class="btn_1"><a href="#">home page</a></li>
            <li class="line"></li>
            <li class="btn_2"><a href="#">about us</a></li>
            <li class="line"></li>
            <li class="btn_3"><a href="#">bouquets</a></li>
            <li class="line"></li>
            <li class="btn_4"><a href="#">specials</a></li>
            <li class="line"></li>
            <li class="btn_5"><a href="#">contacts</a></li>
        </ul>
    </div>

    <div id="header">
        <img src="~/images/slogan2.gif" id="slogan2" />
    </div>

    <div id="content">
        @RenderBody()
    </div>

</div>

<div id="footer">
    <p>
        Copyright © Floral Design |
        Design by Website Templates
    </p>
</div>

</body>
</html>